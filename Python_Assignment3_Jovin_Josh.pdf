BT 1 0 0 1 6 469.9 Tm /F3 7.1 Tf 9 TL (from time import perf_counter) Tj T* (import random) Tj T*  T* (def normalize_phone\(phone\):) Tj T* (    digits = "".join\(ch for ch in str\(phone\) if ch.isdigit\(\)\)) Tj T* (    # Assignment example assumes Indian 10-digit local numbers.) Tj T* (    return digits[-10:] if len\(digits\) >= 10 else digits) Tj T*  T* (def normalize_name\(name\):) Tj T* (    return " ".join\(str\(name or ""\).casefold\(\).split\(\)\)) Tj T*  T* (def merge_contacts\(records\):) Tj T* (    people = {}          # person_id -> merged contact) Tj T* (    number_to_person = {}  # normalized number -> person_id) Tj T* (    next_id = 0) Tj T*  T* (    for record in records:) Tj T* (        name = str\(record.get\("name"\) or ""\).strip\(\)) Tj T* (        numbers = {normalize_phone\(x\) for x in record.get\("phones", []\)) Tj T* (                   if normalize_phone\(x\)}) Tj T* (        emails = {str\(x\).strip\(\).casefold\(\)) Tj T* (                  for x in record.get\("emails", []\) if str\(x\).strip\(\)}) Tj T*  T* (        matched_ids = {number_to_person[n] for n in numbers) Tj T* (                       if n in number_to_person}) Tj T*  T* (        if not matched_ids:) Tj T* (            person_id = next_id) Tj T* (            next_id += 1) Tj T* (            people[person_id] = {) Tj T* (                "name": name,) Tj T* (                "normalized_name": normalize_name\(name\),) Tj T* (                "phones": set\(\),) Tj T* (                "emails": set\(\)) Tj T* (            }) Tj T* (        else:) Tj T* (            person_id = min\(matched_ids\)) Tj T* (            # Merge any previously separate groups connected by this record.) Tj T* (            for other_id in sorted\(matched_ids - {person_id}\):) Tj T* (                people[person_id]["phones"].update\(people[other_id]["phones"]\)) Tj T* (                people[person_id]["emails"].update\(people[other_id]["emails"]\)) Tj T* (                if not people[person_id]["name"]:) Tj T* (                    people[person_id]["name"] = people[other_id]["name"]) Tj T* (                del people[other_id]) Tj T* (                for number, owner in list\(number_to_person.items\(\)\):) Tj T* (                    if owner == other_id:) Tj T* (                        number_to_person[number] = person_id) Tj T*  T* (        person = people[person_id]) Tj T* (        person["phones"].update\(numbers\)) Tj T* (        person["emails"].update\(emails\)) Tj T* (        if not person["name"] and name:) Tj T* (            person["name"] = name) Tj T* ET
