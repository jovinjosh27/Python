BT 1 0 0 1 6 460.9 Tm /F3 7.1 Tf 9 TL (from time import perf_counter) Tj T* (import random) Tj T* (import sys) Tj T*  T* (def clean_loop\(readings\):) Tj T* (    valid = []) Tj T* (    for c in readings:) Tj T* (        if -50 <= c <= 50:) Tj T* (            valid.append\(c\)) Tj T* (    return valid) Tj T*  T* (def clean_comprehension\(readings\):) Tj T* (    return [c for c in readings if -50 <= c <= 50]) Tj T*  T* (def clean_map_filter\(readings\):) Tj T* (    return list\(filter\(lambda c: -50 <= c <= 50, readings\)\)) Tj T*  T* (def convert_fahrenheit\(celsius\):) Tj T* (    return [\(c * 9 / 5\) + 32 for c in celsius]) Tj T*  T* (def alarm_minutes\(readings\):) Tj T* (    return [minute for minute, c in enumerate\(readings, start=1\)) Tj T* (            if -50 <= c <= 50 and not \(2 <= c <= 8\)]) Tj T*  T* (if __name__ == "__main__":) Tj T* (    readings = [-60, -50, -10, 2, 5, 8, 9, 51, 20]) Tj T* (    a = clean_loop\(readings\)) Tj T* (    b = clean_comprehension\(readings\)) Tj T* (    c = clean_map_filter\(readings\)) Tj T* (    assert a == b == c) Tj T* (    print\("Valid Celsius:", a\)) Tj T* (    print\("Fahrenheit:", [round\(x, 1\) for x in convert_fahrenheit\(a\)]\)) Tj T* (    print\("Alarm minutes:", alarm_minutes\(readings\)\)) Tj T*  T* (    for n in \(10_000, 100_000, 1_000_000\):) Tj T* (        data = [random.uniform\(-60, 60\) for _ in range\(n\)]) Tj T* (        for name, function in [) Tj T* (            \("loop", clean_loop\),) Tj T* (            \("comprehension", clean_comprehension\),) Tj T* (            \("map/filter", clean_map_filter\)) Tj T* (        ]:) Tj T* (            t0 = perf_counter\(\)) Tj T* (            result = function\(data\)) Tj T* (            print\(n, name, round\(perf_counter\(\) - t0, 6\),) Tj T* (                  "seconds; valid =", len\(result\)\)) Tj T*  T* (    # Compare materialized list and generator container sizes.) Tj T* (    data = [random.uniform\(-60, 60\) for _ in range\(100_000\)]) Tj T* (    result_list = [x for x in data if -50 <= x <= 50]) Tj T* (    result_gen = \(x for x in data if -50 <= x <= 50\)) Tj T* (    print\("list container bytes:", sys.getsizeof\(result_list\)\)) Tj T* (    print\("generator object bytes:", sys.getsizeof\(result_gen\)\)) Tj T* ET
