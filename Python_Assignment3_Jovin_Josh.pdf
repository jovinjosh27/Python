BT 1 0 0 1 6 613.9 Tm /F3 7.1 Tf 9 TL (from collections import defaultdict) Tj T* (from time import perf_counter) Tj T* (import random) Tj T*  T* (# train -> operating days and ordered \(station, arrival, departure\) stops) Tj T* (timetable = {) Tj T* (    "T101": {) Tj T* (        "days": {"Mon", "Tue", "Wed", "Thu", "Fri"},) Tj T* (        "stops": [) Tj T* (            \("Chennai", "06:00", "06:05"\),) Tj T* (            \("Katpadi", "08:00", "08:05"\),) Tj T* (            \("Bengaluru", "10:00", "10:10"\)) Tj T* (        ]) Tj T* (    },) Tj T* (    "T202": {) Tj T* (        "days": {"Mon", "Wed", "Fri"},) Tj T* (        "stops": [) Tj T* (            \("Chennai", "07:00", "07:10"\),) Tj T* (            \("Jolarpettai", "09:00", "09:05"\),) Tj T* (            \("Bengaluru", "11:00", "11:10"\)) Tj T* (        ]) Tj T* (    }) Tj T* (}) Tj T*  T* (def build_station_index\(data\):) Tj T* (    index = defaultdict\(list\)) Tj T* (    for train, details in data.items\(\):) Tj T* (        for stop_number, stop in enumerate\(details["stops"]\):) Tj T* (            station = stop[0]) Tj T* (            index[station].append\(\(train, stop_number\)\)) Tj T* (    return dict\(index\)) Tj T*  T* (def query_without_index\(data, station, day\):) Tj T* (    result = []) Tj T* (    for train, details in data.items\(\):) Tj T* (        if day in details["days"]:) Tj T* (            for stop in details["stops"]:) Tj T* (                if stop[0] == station:) Tj T* (                    result.append\(\(train, stop[1], stop[2]\)\)) Tj T* (    return result) Tj T*  T* (def query_with_index\(data, index, station, day\):) Tj T* (    result = []) Tj T* (    for train, stop_number in index.get\(station, []\):) Tj T* (        details = data[train]) Tj T* (        if day in details["days"]:) Tj T* (            stop = details["stops"][stop_number]) Tj T* (            result.append\(\(train, stop[1], stop[2]\)\)) Tj T* (    return result) Tj T*  T* (if __name__ == "__main__":) Tj T* (    station_index = build_station_index\(timetable\)) Tj T* (    print\("without index:", query_without_index\(timetable, "Bengaluru", "Mon"\)\)) Tj T* (    print\("with index:", query_with_index\(timetable, station_index, "Bengaluru", "Mon"\)\)) Tj T* (    print\("unknown station:", query_with_index\(timetable, station_index, "Unknown", "Mon"\)\)) Tj T* (    print\("not running day:", query_with_index\(timetable, station_index, "Chennai", "Sun"\)\)) Tj T*  T* (    # Departure time of the third station of T101:) Tj T* (    print\("third station departure:", timetable["T101"]["stops"][2][2]\)) Tj T*  T* (    # Simple scalable synthetic timetable and query benchmark.) Tj T* (    def make_timetable\(number_of_trains\):) Tj T* (        data = {}) Tj T* (        stations = [f"Station{i}" for i in range\(50\)]) Tj T* (        for i in range\(number_of_trains\):) Tj T* (            stops = []) Tj T* (            chosen = random.sample\(stations, 10\)) Tj T* (            for j, station in enumerate\(chosen\):) Tj T* (                stops.append\(\(station, f"{j:02d}:00", f"{j:02d}:05"\)\)) Tj T* ET
